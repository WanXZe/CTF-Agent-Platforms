# ============================================================
# CTF-Agent 敏感凭证配置（.env）
# 所有 API Key、Token、密钥等隐私信息全部在此文件
# 此文件不提交到 git
# ============================================================

# ========== 靶场平台 Access Key（每个平台对应一个环境变量）==========
# 本地 Mock 靶场
MOCK_ACCESS_KEY=
# 西湖论剑 slab-match（X-Agent-AccessKey header）
SLAB_ACCESS_KEY=
# CTFd 平台（Authorization: Bearer token）
CTFD_TOKEN=

# ========== LLM 模型 API Key（全部隐私信息）==========
# 阿里百炼（OpenAI 兼容）
BAILIAN_API_KEY=
# DeepSeek
DEEPSEEK_API_KEY=
# OpenAI
OPENAI_API_KEY=
# Anthropic Claude
ANTHROPIC_API_KEY=
# Google Gemini
GEMINI_API_KEY=

# ========== 其他隐私配置 ==========
# Web 访问密码（留空则不启用）
MUTEKI_PASSWORD=
# 沙箱 Docker 注册表凭证（如需私有镜像）
DOCKER_REGISTRY_USER=
DOCKER_REGISTRY_PASS=
